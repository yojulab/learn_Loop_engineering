# 기존 앱(/apps/*) 코드 수정 없이 Base URL만 프록시로 전환하는 무코드 관측 설정
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_API_KEY=sk-litellm-local
LITELLM_MASTER_KEY=sk-litellm-local

# Langfuse Callback 연결 정보 (LiteLLM Proxy 컨테이너가 사용)
LANGFUSE_HOST=http://localhost:30000
LANGFUSE_PUBLIC_KEY=pk-lf-loop-engineering-public
LANGFUSE_SECRET_KEY=sk-lf-loop-engineering-secret
