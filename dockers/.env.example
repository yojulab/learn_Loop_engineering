# ============================================================
# Common
# ============================================================
PROJECT_NAME=learn_loop_engineering
# 같은 이름의 dockers/ 폴더를 쓰는 다른 프로젝트와 컨테이너·네트워크가 섞이지 않도록 고정
COMPOSE_PROJECT_NAME=learn_loop_engineering
TZ=Asia/Seoul

# ============================================================
# 볼륨 (호스트 경로: 상대 경로는 dockers/ 기준)
#  - APP_SOURCE_DIR      : 실습 코드(저장소 루트)를 /apps/learn_Loop_engineering 에 마운트
# ============================================================
APP_SOURCE_DIR=..

# ============================================================
# PostgreSQL (Langfuse 전용)
#  - 비밀번호에 @ : / 등 URL 예약 문자는 사용하지 마세요 (DATABASE_URL 에 포함됨)
# ============================================================
POSTGRES_IMAGE_TAG=16
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# ============================================================
# Langfuse (LLM Observability & Prompt Management)
#  - 시크릿 생성: openssl rand -hex 32
# ============================================================
LANGFUSE_IMAGE_TAG=2
LANGFUSE_DB_NAME=db_langfuse
LANGFUSE_NEXTAUTH_SECRET=3cc4efc19dec2a3a4a017384aa3201c3843174bcbee8d21e73d0b7589d9ca4b7
LANGFUSE_SALT=818532cc6f4f58d9b899c26aae0dd1a1d0567f51b46cd0eacd84ab12fd9be63c
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_TELEMETRY_ENABLED=false

# 최초 구동 시 자동 프로비저닝 (이미 DB가 있으면 무시됨)
LANGFUSE_INIT_ORG_ID=loop-org
LANGFUSE_INIT_ORG_NAME=Loop Engineering Org
LANGFUSE_INIT_PROJECT_ID=loop-project
LANGFUSE_INIT_PROJECT_NAME=Loop Engineering
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=admin123456

# 앱 컨테이너가 사용하는 Langfuse 접속 정보 (도커 내부 네트워크 주소)
#  - LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 는 위 프로젝트의 초기 API Key 로도 사용됩니다.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-loop-engineering-public
LANGFUSE_SECRET_KEY=sk-lf-loop-engineering-secret

# ============================================================
# LLM 플랫폼 (필요한 것만 입력. 비워 두면 offline-fallback 으로 동작)
#  - Claude CLI 는 키 대신 컨테이너에서 `claude` 실행 후 로그인해도 됩니다.
#  - *_BASE_URL / *_MODEL 은 값이 있을 때만 주석을 해제하세요. (빈 값으로 두면 기본값을 덮어씁니다)
# ============================================================
AGENT_PLATFORM=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
# OPENAI_MODEL=
# GEMINI_MODEL=
